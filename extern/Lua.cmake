if (JFC_LUA_BACKEND STREQUAL "luajit")
    # excluded so that installing this library does not install LuaJIT's executable and headers too
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/LuaJIT" EXCLUDE_FROM_ALL)

    # replaced rather than added to: LuaJIT's own are plain paths, which an installed target cannot export
    set_target_properties(libluajit PROPERTIES INTERFACE_INCLUDE_DIRECTORIES
        "$<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}/LuaJIT/src>;$<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/LuaJIT/src>")

    # replaced rather than added to: find_library's whole paths would tie an installed package to this machine
    if (UNIX)
        set_target_properties(libluajit PROPERTIES INTERFACE_LINK_LIBRARIES "m;${CMAKE_DL_LIBS}")
    else()
        set_property(TARGET libluajit APPEND PROPERTY INTERFACE_LINK_LIBRARIES ${CMAKE_DL_LIBS})
    endif()

    set(JFC_LUA_TARGET "libluajit" CACHE INTERNAL "the cmake target the lua backend builds")

elseif (JFC_LUA_BACKEND STREQUAL "lua51")

    set(_lua_root "${CMAKE_CURRENT_LIST_DIR}/lua51/src")
    set(_lua_config "${CMAKE_CURRENT_BINARY_DIR}/lua51-config")

    configure_file("${_lua_root}/luaconf.h.orig" "${_lua_config}/luaconf.h" COPYONLY)

    set(_lua_sources
        lapi.c lcode.c ldebug.c ldo.c ldump.c lfunc.c lgc.c llex.c lmem.c
        lobject.c lopcodes.c lparser.c lstate.c lstring.c ltable.c ltm.c
        lundump.c lvm.c lzio.c lauxlib.c lbaselib.c ldblib.c liolib.c
        lmathlib.c loslib.c ltablib.c lstrlib.c loadlib.c linit.c)

    list(TRANSFORM _lua_sources PREPEND "${_lua_root}/")

    # 5.1.5's luaH_getnum subtracts before its unsigned cast, which overflows at INT_MIN: compile a copy that casts first
    set(_lua_table_line "cast(unsigned int, key-1) < cast(unsigned int, t->sizearray)")
    set(_lua_table_copy "${CMAKE_CURRENT_BINARY_DIR}/lua51-patched/ltable.c")

    file(READ "${_lua_root}/ltable.c" _lua_table)
    string(FIND "${_lua_table}" "${_lua_table_line}" _lua_table_at)

    if (_lua_table_at EQUAL -1)
        message(FATAL_ERROR "extern/lua51/src/ltable.c no longer has the line jfc-lua replaces")
    endif()

    string(REPLACE "${_lua_table_line}" "cast(unsigned int, key) - 1u < cast(unsigned int, t->sizearray)"
        _lua_table "${_lua_table}")
    file(WRITE "${_lua_table_copy}.new" "${_lua_table}")
    configure_file("${_lua_table_copy}.new" "${_lua_table_copy}" COPYONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_lua_root}/ltable.c")

    list(REMOVE_ITEM _lua_sources "${_lua_root}/ltable.c")
    list(APPEND _lua_sources "${_lua_table_copy}")

    set_source_files_properties(${_lua_sources} PROPERTIES LANGUAGE CXX)

    add_library(liblua STATIC ${_lua_sources})

    set_target_properties(liblua PROPERTIES OUTPUT_NAME lua LINKER_LANGUAGE CXX
        CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)

    target_compile_options(liblua PRIVATE $<IF:$<CXX_COMPILER_ID:MSVC>,/w,-w>)

    set(_lua_numbers "${CMAKE_CURRENT_LIST_DIR}/lua51_numbers.h")

    if (MSVC)
        set(_lua_force_numbers "/FI${_lua_numbers}")
    else()
        set(_lua_force_numbers -include "${_lua_numbers}")
    endif()

    set_source_files_properties("${_lua_root}/lobject.c" "${_lua_root}/lvm.c" PROPERTIES
        COMPILE_OPTIONS "${_lua_force_numbers}")

    if (_jfc_lua_apple_device)
        set_source_files_properties("${_lua_root}/loslib.c" PROPERTIES
            COMPILE_OPTIONS "-include;${CMAKE_CURRENT_LIST_DIR}/lua51_apple_device.h")
    endif()

    target_include_directories(liblua PUBLIC
        "$<BUILD_INTERFACE:${_lua_config}>"
        "$<BUILD_INTERFACE:${_lua_root}>")

    if (EMSCRIPTEN)
        target_compile_definitions(liblua PRIVATE LUA_USE_POSIX)
    else()
        target_compile_definitions(liblua PRIVATE LUA_USE_POSIX LUA_USE_DLOPEN)
    endif()

    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/lua-hpp/lua.hpp"
"// generated by extern/Lua.cmake\n"
"//\n"
"// the release's lua.hpp assumes C linkage. lua is built as c++ here, so not extern \"C\".\n"
"#include \"lua.h\"\n"
"#include \"lualib.h\"\n"
"#include \"lauxlib.h\"\n")

    target_include_directories(liblua PUBLIC
        "$<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/lua-hpp>")

    target_link_libraries(liblua PUBLIC ${CMAKE_DL_LIBS} m)

    set(JFC_LUA_TARGET "liblua" CACHE INTERNAL "the cmake target the lua backend builds")

else()
    message(FATAL_ERROR
        "JFC_LUA_BACKEND is \"${JFC_LUA_BACKEND}\" but must be one of: luajit, lua51")
endif()


if (JFC_LUA_BACKEND STREQUAL "luajit")
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/LuaJIT")

    target_include_directories(libluajit PUBLIC
        "$<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}/LuaJIT/src>"
        "$<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/LuaJIT/src>")

    set_property(TARGET libluajit APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES ${CMAKE_DL_LIBS})

    set(JFC_LUA_TARGET "libluajit" CACHE INTERNAL "the cmake target the lua backend builds")

elseif (JFC_LUA_BACKEND STREQUAL "lua51")

    set(_lua_root "${CMAKE_CURRENT_LIST_DIR}/lua51")

    file(GLOB _lua_sources "${_lua_root}/*.c")

    list(REMOVE_ITEM _lua_sources
        "${_lua_root}/lua.c"      
        "${_lua_root}/luac.c"     
        "${_lua_root}/ltests.c")  

    set_source_files_properties(${_lua_sources} PROPERTIES LANGUAGE CXX)

    add_library(liblua STATIC ${_lua_sources})

    set_target_properties(liblua PROPERTIES OUTPUT_NAME lua LINKER_LANGUAGE CXX)

    target_compile_options(liblua PRIVATE $<IF:$<CXX_COMPILER_ID:MSVC>,/w,-w>)

    set(_lua_numbers "${CMAKE_CURRENT_LIST_DIR}/lua51_numbers.h")

    if (MSVC)
        set(_lua_force_numbers "/FI${_lua_numbers}")
    else()
        set(_lua_force_numbers -include "${_lua_numbers}")
    endif()

    set_source_files_properties("${_lua_root}/lobject.c" "${_lua_root}/lvm.c" PROPERTIES
        COMPILE_OPTIONS "${_lua_force_numbers}")

    target_include_directories(liblua PUBLIC "${_lua_root}")

    if (EMSCRIPTEN)
        target_compile_definitions(liblua PRIVATE LUA_USE_POSIX)
    else()
        target_compile_definitions(liblua PRIVATE LUA_USE_POSIX LUA_USE_DLOPEN)
    endif()

    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/lua-hpp/lua.hpp"
"// generated by extern/Lua.cmake\n"
"//\n"
"// puc lua ships this only in its release tarball's etc/ directory, so it is not in the git tree the\n"
"// submodule points at. luajit has it in src/. lua is built as c++ here, so not extern \"C\".\n"
"#include \"lua.h\"\n"
"#include \"lualib.h\"\n"
"#include \"lauxlib.h\"\n")

    target_include_directories(liblua PUBLIC
        "$<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/lua-hpp>")

    target_link_libraries(liblua PUBLIC ${CMAKE_DL_LIBS} m)

    set(JFC_LUA_TARGET "liblua" CACHE INTERNAL "the cmake target the lua backend builds")

else()
    message(FATAL_ERROR
        "JFC_LUA_BACKEND is \"${JFC_LUA_BACKEND}\" but must be one of: luajit, lua51")
endif()


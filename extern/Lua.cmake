if (JFC_LUA_BACKEND STREQUAL "luajit")
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/LuaJIT")

    jfc_set_dependency_symbols(
        INCLUDE_PATHS
            "${CMAKE_CURRENT_LIST_DIR}/LuaJIT/src"
            "${CMAKE_CURRENT_BINARY_DIR}/LuaJIT/src"

        LIBRARIES
            "libluajit;${CMAKE_DL_LIBS}"
    )

    set(JFC_LUA_TARGET "libluajit" CACHE INTERNAL "the cmake target the lua backend builds")

elseif (JFC_LUA_BACKEND STREQUAL "lua51")

    set(_lua_root "${CMAKE_CURRENT_LIST_DIR}/lua51")

    file(GLOB _lua_sources "${_lua_root}/*.c")

    list(REMOVE_ITEM _lua_sources
        "${_lua_root}/lua.c"      
        "${_lua_root}/luac.c"     
        "${_lua_root}/ltests.c")  

    add_library(liblua STATIC ${_lua_sources})

    set_target_properties(liblua PROPERTIES OUTPUT_NAME lua C_STANDARD 90)

    target_include_directories(liblua PUBLIC "${_lua_root}")

    target_compile_definitions(liblua PRIVATE LUA_USE_POSIX LUA_USE_DLOPEN)

    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/lua-hpp/lua.hpp"
"// generated by extern/Lua.cmake\n"
"//\n"
"// puc lua ships this only in its release tarball's etc/ directory, so it is not in the git tree the\n"
"// submodule points at. luajit has it in src/.\n"
"extern \"C\" {\n"
"#include \"lua.h\"\n"
"#include \"lualib.h\"\n"
"#include \"lauxlib.h\"\n"
"}\n")

    jfc_set_dependency_symbols(
        INCLUDE_PATHS
            "${_lua_root}"
            "${CMAKE_CURRENT_BINARY_DIR}/lua-hpp"

        LIBRARIES
            "liblua;${CMAKE_DL_LIBS};m"
    )

    set(JFC_LUA_TARGET "liblua" CACHE INTERNAL "the cmake target the lua backend builds")

else()

    message(FATAL_ERROR
        "JFC_LUA_BACKEND is \"${JFC_LUA_BACKEND}\" but must be one of: luajit, lua51")

endif()


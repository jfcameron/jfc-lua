{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "JFC_BUILD_TESTS": "ON",
        "JFC_BUILD_DEMO": "OFF",
        "JFC_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux / gcc",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "linux-gcc-lua51",
      "displayName": "Linux / gcc / puc lua 5.1",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra",
        "JFC_LUA_BACKEND": "lua51"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux / clang",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "linux-gcc-demo",
      "displayName": "Linux / gcc / demo",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "JFC_BUILD_DEMO": "ON",
        "JFC_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS / clang / libc++",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -stdlib=libc++"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows / MSVC",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /EHs /permissive-"
      }
    },
    {
      "name": "linux-docs",
      "displayName": "Linux / documentation",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "JFC_BUILD_DOCS": "ON",
        "JFC_BUILD_TESTS": "OFF",
        "JFC_BUILD_DEMO": "OFF"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS / clang (device, compile only)",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "description": "The tests are built but not run: they need a device or a simulator.",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS simulator / clang (arm64)",
      "inherits": "ios",
      "description": "Boot a simulator first: ctest runs the tests in the booted one.",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_CROSSCOMPILING_EMULATOR": "xcrun;simctl;spawn;booted"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android / arm64-v8a / NDK clang",
      "description": "Set ANDROID_NDK_HOME to an NDK (r23 or later). ctest runs the tests on the device or emulator adb is connected to.",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/jfc-cmake/toolchains/toolchain-android.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "android-armv7",
      "displayName": "Android / armeabi-v7a / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "armeabi-v7a"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android / x86_64 / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "android-x86",
      "displayName": "Android / x86 / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "x86"
      }
    },
    {
      "name": "emscripten",
      "displayName": "Emscripten / wasm",
      "description": "Configure with `emcmake cmake --preset emscripten`, which supplies the toolchain file. The backend is lua51, LuaJIT having no WebAssembly target; ctest runs the tests under node. The heap may grow: the memory budget tests fill more than a page starts with. Exceptions are WebAssembly's own, which lua's errors are, PUC Lua being built as c++: they cost nothing until thrown, where -fexceptions slows every call that might throw.",
      "inherits": "base",
      "cacheVariables": {
        "JFC_LUA_BACKEND": "lua51",
        "CMAKE_C_FLAGS": "-fwasm-exceptions",
        "CMAKE_CXX_FLAGS": "-fwasm-exceptions -Wall -Wextra",
        "CMAKE_EXE_LINKER_FLAGS": "-fwasm-exceptions -sALLOW_MEMORY_GROWTH",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "targets": [
        "jfclua",
        "jfclua_test_0"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-lua51",
      "configurePreset": "linux-gcc-lua51",
      "targets": [
        "jfclua",
        "jfclua_test_0"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "targets": [
        "jfclua",
        "jfclua_test_0"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-demo",
      "configurePreset": "linux-gcc-demo",
      "targets": [
        "jfclua-demo-values",
        "jfclua-demo-environments",
        "jfclua-demo-serialization",
        "jfclua-demo-limits"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang",
      "targets": [
        "jfclua",
        "jfclua_test_0"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "RelWithDebInfo",
      "targets": [
        "jfclua",
        "jfclua_test_0"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "emscripten",
      "configurePreset": "emscripten",
      "targets": [
        "jfclua",
        "jfclua_test_0"
      ]
    },
    {
      "name": "ios",
      "configurePreset": "ios"
    },
    {
      "name": "ios-simulator",
      "configurePreset": "ios-simulator"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    },
    {
      "name": "android-armv7",
      "configurePreset": "android-armv7"
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64"
    },
    {
      "name": "android-x86",
      "configurePreset": "android-x86"
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "filter": {
        "include": {
          "name": "jfclua_test_0"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-lua51",
      "configurePreset": "linux-gcc-lua51",
      "filter": {
        "include": {
          "name": "jfclua_test_0"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "filter": {
        "include": {
          "name": "jfclua_test_0"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang",
      "filter": {
        "include": {
          "name": "jfclua_test_0"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "RelWithDebInfo",
      "filter": {
        "include": {
          "name": "jfclua_test_0"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "emscripten",
      "configurePreset": "emscripten",
      "filter": {
        "include": {
          "name": "jfclua_test_0"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
